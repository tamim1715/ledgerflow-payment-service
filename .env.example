# LedgerFlow Payment & Billing Service Environment Configuration Example

# Server Settings
LEDGERFLOW_SERVER_NAME=ledgerflow-payment-service
LEDGERFLOW_SERVER_PORT=8081
LEDGERFLOW_SERVER_READ_TIMEOUT=15s
LEDGERFLOW_SERVER_WRITE_TIMEOUT=15s
LEDGERFLOW_SERVER_SHUTDOWN_TIMEOUT=10s

# Database Settings (PostgreSQL)
LEDGERFLOW_DATABASE_HOST=localhost
LEDGERFLOW_DATABASE_PORT=5432
LEDGERFLOW_DATABASE_USERNAME=postgres
LEDGERFLOW_DATABASE_PASSWORD=postgres
LEDGERFLOW_DATABASE_NAME=ledgerflow
LEDGERFLOW_DATABASE_SSL_MODE=disable
LEDGERFLOW_DATABASE_MAX_OPEN_CONNS=50
LEDGERFLOW_DATABASE_MAX_IDLE_CONNS=25
LEDGERFLOW_DATABASE_CONN_MAX_LIFETIME=30m
LEDGERFLOW_DATABASE_CONN_MAX_IDLE_TIME=10m

# Logger Settings
LEDGERFLOW_LOGGER_LEVEL=info
LEDGERFLOW_LOGGER_DEVELOPMENT=true
