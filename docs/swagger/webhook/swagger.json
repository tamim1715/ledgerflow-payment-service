{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/webhooks/events": {
            "get": {
                "description": "Returns paginated audit log of ingested webhook events",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Webhooks"
                ],
                "summary": "List received webhook events",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by provider",
                        "name": "provider",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Items per page",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/webhooks/{provider}": {
            "post": {
                "description": "Receives asynchronous webhooks from payment gateways (Stripe, SSLCommerz, bKash, PayPal), verifies event deduplication, normalizes payloads, and updates payment state and linked invoice",
                "consumes": [
                    "application/json",
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Webhooks"
                ],
                "summary": "Ingest payment provider webhook event",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Payment Gateway Provider (STRIPE, SSLCOMMERZ, BKASH, PAYPAL)",
                        "name": "provider",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/webhook.WebhookProcessResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "payment.PaymentProvider": {
            "type": "string",
            "enum": [
                "STRIPE",
                "SSLCOMMERZ",
                "PAYPAL",
                "BKASH"
            ],
            "x-enum-varnames": [
                "ProviderStripe",
                "ProviderSSLCommerz",
                "ProviderPayPal",
                "ProviderBKash"
            ]
        },
        "payment.PaymentResponse": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number",
                    "example": 99.99
                },
                "bill_id": {
                    "type": "string",
                    "example": "bill_123abc456def"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-08-08T12:00:00Z"
                },
                "currency": {
                    "type": "string",
                    "example": "USD"
                },
                "customer_id": {
                    "type": "string",
                    "example": "cust_987654"
                },
                "description": {
                    "type": "string",
                    "example": "Payment for Invoice #1234"
                },
                "id": {
                    "type": "string",
                    "example": "pay_123abc456def"
                },
                "idempotency_key": {
                    "type": "string",
                    "example": "ik_987654321"
                },
                "metadata": {
                    "type": "object"
                },
                "payment_url": {
                    "type": "string",
                    "example": "https://checkout.stripe.com/pay/cs_test_123"
                },
                "provider": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/payment.PaymentProvider"
                        }
                    ],
                    "example": "STRIPE"
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/payment.PaymentStatus"
                        }
                    ],
                    "example": "SUCCEEDED"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-08-08T12:00:00Z"
                }
            }
        },
        "payment.PaymentStatus": {
            "type": "string",
            "enum": [
                "PENDING",
                "PROCESSING",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED",
                "REFUNDED",
                "PARTIALLY_REFUNDED"
            ],
            "x-enum-varnames": [
                "PaymentStatusPending",
                "PaymentStatusProcessing",
                "PaymentStatusSucceeded",
                "PaymentStatusFailed",
                "PaymentStatusCancelled",
                "PaymentStatusRefunded",
                "PaymentStatusPartiallyRefunded"
            ]
        },
        "webhook.WebhookProcessResult": {
            "type": "object",
            "properties": {
                "event_id": {
                    "type": "string",
                    "example": "evt_123456789"
                },
                "event_type": {
                    "type": "string",
                    "example": "payment_intent.succeeded"
                },
                "message": {
                    "type": "string",
                    "example": "Webhook processed successfully"
                },
                "payment": {
                    "$ref": "#/definitions/payment.PaymentResponse"
                },
                "provider": {
                    "type": "string",
                    "example": "STRIPE"
                },
                "status": {
                    "type": "string",
                    "example": "PROCESSED"
                }
            }
        }
    }
}