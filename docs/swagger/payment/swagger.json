    "definitions": {
        "payment.CancelPaymentRequest": {
            "type": "object",
            "properties": {
                "reason": {
                    "type": "string",
                    "example": "Customer requested cancellation"
                }
            }
        },
        "payment.CreateCustomerRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "customer@example.com"
                },
                "name": {
                    "type": "string",
                    "example": "Alex Morgan"
                },
                "phone": {
                    "type": "string",
                    "example": "+1234567890"
                },
                "stripe_customer_id": {
                    "type": "string",
                    "example": "cus_123abc"
                }
            }
        },
        "payment.CreatePaymentRequest": {
            "type": "object",
            "required": [
                "amount",
                "currency",
                "customer_id",
                "idempotency_key",
                "provider"
            ],
            "properties": {
                "amount": {
                    "type": "number",
                    "example": 99.99
                },
                "bill_id": {
                    "type": "string",
                    "example": "bill_123abc456def"
                },
                "currency": {
                    "type": "string",
                    "example": "USD"
